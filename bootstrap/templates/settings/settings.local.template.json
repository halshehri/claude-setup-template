{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-4-6",
  "includeCoAuthoredBy": true,
  "cleanupPeriodDays": 30,
  "statusLine": {
    "type": "command",
    "command": "printf '%s | %s' \"$(git branch --show-current 2>/dev/null || echo no-git)\" \"{{PROJECT_NAME}}\""
  },
  "env": {
    "PROJECT_NAME": "{{PROJECT_NAME}}"
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Edit(**)",
      "Write(**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash({{TEST_COMMAND}}:*)",
      "Bash({{BUILD_COMMAND}}:*)",
      "Bash({{LINT_COMMAND}}:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(npm publish:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)"
    ]
  }
}
